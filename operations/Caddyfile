# Caddy HTTPS ingress for A0.
# Primary public hostname: nip.io maps the VM's external IP so a real
# Let's Encrypt certificate can be issued without operator DNS changes.
# To move to an org hostname, add the DNS record, then add the name here and
# reload: sudo systemctl reload a0-caddy.

{
	email ops@interdependentway.org
	admin off
}

https://35.212.252.101.nip.io, https://35.212.252.101.sslip.io {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8787 {
		flush_interval -1
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		-Server
	}
	log {
		output file /var/log/caddy/a0-access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

http://35.212.252.101.nip.io, http://35.212.252.101.sslip.io {
	redir https://{host}{uri} permanent
}
