[Unit]
Description=A0 website and API (phone-first authenticated BYOK chat)
After=network-online.target postgresql@16-main.service openbao.service
Wants=network-online.target
Requires=postgresql@16-main.service openbao.service

[Service]
Type=simple
User=a0app
Group=a0app
WorkingDirectory=/opt/a0
EnvironmentFile=/etc/a0/a0.env
ExecStart=/usr/bin/node apps/server/src/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

# No local shell/tool execution boundary is implemented: the app is not a
# sandbox. Keep it away from Docker control, host admin, and vault keys.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/a0/media /srv/a0/backups
CapabilityBoundingSet=
AmbientCapabilities=
UMask=027

[Install]
WantedBy=multi-user.target
