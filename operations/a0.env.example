# A0 server environment — example with nonsecret defaults only.
# The real file lives at /etc/a0/a0.env (root:a0app 0640) and is never committed.

NODE_ENV=production
A0_HOST=127.0.0.1
A0_PORT=8787
A0_PUBLIC_ORIGIN=https://35.212.252.101.nip.io

# PostgreSQL application database (separate role/database from OpenBao's).
A0_DATABASE_URL=postgres://a0_app:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5432/a0app

# OpenBao scoped application token + KV mount.
BAO_ADDR=http://127.0.0.1:8200
BAO_TOKEN=REPLACE_WITH_SCOPED_APP_TOKEN
BAO_KV_MOUNT=a0

# One-time owner bootstrap. Generate with: openssl rand -hex 16
A0_BOOTSTRAP_CODE=REPLACE_WITH_ONE_TIME_SETUP_CODE

# Session signing secret (>= 32 chars). Generate with: openssl rand -hex 32
A0_SESSION_SECRET=REPLACE_WITH_RANDOM_HEX_64

# Media and limits.
A0_MEDIA_ROOT=/srv/a0/media
A0_MAX_UPLOAD_BYTES=10485760
A0_MAX_PARTICIPANTS=4
A0_MAX_TOOL_STEPS=6
A0_REQUEST_TIMEOUT_MS=120000
